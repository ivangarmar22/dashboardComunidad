# Endesa · Zonas comunes
ENDESA_COMUNES_USER=email@ejemplo.com
ENDESA_COMUNES_PASSWORD=tu_contraseña
ENDESA_COMUNES_CLIENT_ID=
ENDESA_COMUNES_CONTRACT_ID=
# Opcionales: si se dejan vacías se inicia sesión automáticamente
ENDESA_COMUNES_COOKIE=
ENDESA_COMUNES_SESSION_ID=

# Endesa · Portales 1-7
ENDESA_PORTALES_USER=email@ejemplo.com
ENDESA_PORTALES_PASSWORD=tu_contraseña
ENDESA_PORTALES_CLIENT_ID=tu_client_id
ENDESA_PORTALES_CONTRACT_ID=tu_contract_id
ENDESA_PORTALES_COOKIE=
ENDESA_PORTALES_SESSION_ID=

# Endesa · Portal Mi Empresa (facturas)
ENDESA_BILLING_USER=email@ejemplo.com
ENDESA_BILLING_PASSWORD=tu_contraseña
ENDESA_BILLING_SF_CONTRACT_ID=tu_sf_contract_id
# Opcionales: con usuario y contraseña se obtienen solos
ENDESA_BILLING_COOKIE=
ENDESA_BILLING_AURA_TOKEN=
ENDESA_BILLING_AURA_FWUID=

# Sincronización
# Horas entre sincronizaciones (0 = desactivada)
SYNC_INTERVAL_HOURS=6
# Si se define, los POST .../refresh exigen la cabecera x-admin-token
ADMIN_TOKEN=

# Servidor
PORT=4000
NODE_ENV=development
